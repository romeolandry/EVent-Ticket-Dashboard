# URL de base du site WordPress (sans slash final)
VITE_WP_API_URL=https://votre-site-wordpress.fr

# Authentification Basic (optionnel) — utiliser un "mot de passe d'application"
# WordPress (Utilisateurs > Profil > Mots de passe applicatifs) si l'API
# exige une authentification.
VITE_WP_AUTH_USER=
VITE_WP_AUTH_PASSWORD=
